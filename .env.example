# MyCampus - Environment Configuration
# Copy this file to .env and configure if needed.
# The app works 100% out-of-the-box using the deterministic rule-based parser without any API keys!

# Server Port
PORT=3000

# Optional: LLM API Keys for AI-powered parsing
# If unset, the deterministic fallback regex parser will be used automatically.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
